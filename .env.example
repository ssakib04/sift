# Application name shown in logs and service metadata.
PROJECT_NAME=Sift

# PostgreSQL server hostname. Use `db` inside Docker Compose and `localhost` for a database on the host.
POSTGRES_SERVER=localhost
# Port the Postgres process listens on inside its container or host service.
POSTGRES_PORT=5432
# Host port mapped to Postgres when running Docker Compose from the developer machine.
POSTGRES_HOST_PORT=5433
# Database role used by the API.
POSTGRES_USER=sift
# Password for POSTGRES_USER. Replace this outside local development.
POSTGRES_PASSWORD=sift_secret
# Database name created for Sift.
POSTGRES_DB=sift_db

# SQLAlchemy URL. Host port 5433 matches the Compose mapping above.
DATABASE_URL=postgresql://sift:sift_secret@localhost:5433/sift_db
# Redis URL for queues, caches, and short-lived buffers.
REDIS_URL=redis://localhost:6379/0

# Secret used to sign application tokens. Leave empty locally and set a long random value before deployment.
SECRET_KEY=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Anthropic API key for the primary Claude model. Leave empty to skip to the next provider.
ANTHROPIC_API_KEY=
# Google Gemini API key. When this is set it is also copied onto GOOGLE_API_KEY.
GEMINI_API_KEY=
# Alternate name for the Gemini key. If GEMINI_API_KEY is empty, this value is used for both fields.
GOOGLE_API_KEY=
# Base URL for the local Ollama server. Compose service name `ollama` uses port 11434.
OLLAMA_BASE_URL=http://ollama:11434
# Temperature used when get_llm_client() is called without an explicit temperature.
DEFAULT_LLM_TEMPERATURE=0.0

# Local HuggingFace embedding model used by get_embeddings_model().
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
